# Example environment variables for the FastAPI service. Copy to .env for local use.
MODEL1_PATH=app/api/models/best-pcb.onnx
MODEL2_PATH=app/api/models/best_detect2.onnx
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMG_SIZE=416
DEVICE=cpu
OUTPUT_DIR=/tmp/pcb_api_outputs
MAX_UPLOAD_MB=200
MAX_WORKERS=2
CORS_ORIGINS=*
